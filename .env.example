# Public canonical URL used for metadata, sitemap and social sharing.
NEXT_PUBLIC_SITE_URL=https://lkdwnprints.com

# Server-only Stripe key. Never expose this as a NEXT_PUBLIC_ variable.
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe signs requests to /api/webhooks/stripe with this endpoint secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Server-only Resend key used by the verified Stripe webhook.
RESEND_API_KEY=re_replace_me

# Must use a sender on a domain verified in Resend.
ORDER_CONFIRMATION_FROM=LKDWN Prints <orders@lkdwnprints.co.uk>
ORDER_CONFIRMATION_REPLY_TO=john@lkdwnprints.co.uk

# Keep disabled until Gelato credentials, product UIDs and print files are verified.
GELATO_ENABLED=false

# Server-only Gelato API key. Never expose this as a NEXT_PUBLIC_ variable.
GELATO_API_KEY=replace_me

# Draft is the safe default: orders are transferred but do not enter production.
GELATO_ORDER_TYPE=draft

# Optional separate HTTPS origin for print-ready files. Defaults to NEXT_PUBLIC_SITE_URL.
GELATO_PRINT_FILE_BASE_URL=https://www.lkdwnprints.co.uk

# Map each available orientation/size/frame combination to its Gelato Product UID.
# Keep this JSON on one line when entering it in Vercel.
GELATO_PRODUCT_UIDS={"landscape:a2:unframed":"replace_me","landscape:a2:black":"replace_me","landscape:a2:wood":"replace_me","landscape:a1:unframed":"replace_me","landscape:a1:black":"replace_me","landscape:a1:wood":"replace_me","landscape:a0:unframed":"replace_me","portrait:a2:unframed":"replace_me","portrait:a2:black":"replace_me","portrait:a2:wood":"replace_me","portrait:a1:unframed":"replace_me","portrait:a1:black":"replace_me","portrait:a1:wood":"replace_me","portrait:a0:unframed":"replace_me"}
